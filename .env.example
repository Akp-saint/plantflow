# Environnement (production ou development)
NODE_ENV=production
PORT=3000

# Base de données PostgreSQL
POSTGRES_USER=plantflow
# Remplacez ce mot de passe par une clé robuste en production (ex: openssl rand -base64 24)
POSTGRES_PASSWORD=definir-un-mot-de-passe-solide-ici
POSTGRES_DB=plantflow
POSTGRES_DATABASE_URL=postgresql://plantflow:definir-un-mot-de-passe-solide-ici@localhost:5432/plantflow?schema=public

# URL publique de l'application (votre domaine de production en HTTPS ou http://ip-serveur:3000)
PUBLIC_APP_URL=http://localhost:3000
